# Web 服务端口
WEB_PORT=80

# PHP 配置
PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=300
PHP_UPLOAD_MAX_FILESIZE=10M
PHP_POST_MAX_SIZE=10M

# 时区设置
TZ=Asia/Shanghai

# Vercel Functions（仅 Vercel 部署需要）
EPAY_PID=YOUR_PID
EPAY_KEY=YOUR_SECRET_KEY
EPAY_GATEWAY=https://credit.linux.do/epay
MIN_AMOUNT=0.01
MAX_AMOUNT=9999.99

# BLOB_READ_WRITE_TOKEN 由连接到项目的 Private Blob Store 自动提供，
# 不要手动写入或提交真实 Token。
